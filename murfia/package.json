{
  "name": "murfia",
  "version": "1.0.0",
  "private": true,
  "description": "🐾 МУР-ФИЯ: Кошачьи Разборки — онлайн-мафия для котов",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n сервер,клиент -c yellow,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node server/test/simulate.mjs"
  },
  "dependencies": {
    "express": "^4.21.2",
    "framer-motion": "^11.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.7.0"
  }
}
